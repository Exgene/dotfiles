 /* wallust template - colors-rofi */

* {
active-background: #3B3B3B;
active-foreground: #E3E3E3;
normal-background: #000000;
normal-foreground: #E3E3E3;
urgent-background: #A7A7A7;
urgent-foreground: #E3E3E3;

alternate-active-background: #838383;
alternate-active-foreground: #E3E3E3;
alternate-normal-background: #000000;
alternate-normal-foreground: #E3E3E3;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #E3E3E3;

selected-active-background: #3B3B3B;
selected-active-foreground: #E3E3E3;
selected-normal-background: #CFCFCF;
selected-normal-foreground: #E3E3E3;
selected-urgent-background: #A7A7A7;
background: rgba(0,0,0,0.7);

background-color: #000000;
background: rgba(0,0,0,0.7);
foreground: #CFCFCF;
border-color: #3B3B3B;
}

