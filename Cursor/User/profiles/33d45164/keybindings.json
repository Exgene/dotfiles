// Place your key bindings in this file to override the defaults
[
    {
        "key": "alt+`",
        "command": "workbench.action.chat.newChat",
        "when": "hasChatProvider && inChat"
    },
    {
        "key": "ctrl+l",
        "command": "-workbench.action.chat.newChat",
        "when": "hasChatProvider && inChat"
    },
    {
        "key": "ctrl+l",
        "command": "expandLineSelection",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+p",
        "command": "-expandLineSelection",
        "when": "textInputFocus"
    }
]